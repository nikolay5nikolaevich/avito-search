    {
      "parameters": {
        "jsCode": "// Агент возвращает JSON строкой. Разбираем и подстраховываемся:\n// не разобралось — считаем «горячим», то есть отдаём человеку.\nconst raw = $json.output || $json.text || '';\nlet parsed;\n\ntry {\n  const clean = String(raw).replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(clean);\n} catch (e) {\n  parsed = { class: 'hot', reply: '', reason: 'ответ модели не разобран: ' + e.message };\n}\n\nif (!['typical', 'hot', 'spam'].includes(parsed.class)) parsed.class = 'hot';\n\nconst src = $('Правила ответов').first().json;\n\nreturn [{ json: {\n  class: parsed.class,\n  reply: parsed.reply || '',\n  reason: parsed.reason || '',\n  chat_id: src.chat_id,\n  buyer_name: src.buyer_name,\n  item_title: src.item_title,\n  item_price: src.item_price,\n  item_url: src.item_url || '',\n  message_text: src.message_text\n}}];"
      },
