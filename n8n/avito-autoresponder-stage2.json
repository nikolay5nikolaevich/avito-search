        "jsCode": "// Журнал: что пришло, как классифицировали, что ответили.\n// Без него нельзя разобрать инцидент постфактум.\nconst store = $getWorkflowStaticData('global');\nstore.journal = store.journal || [];\n\nconst rec = {\n  ts: $now.toISO(),\n  chat_id: $json.chat_id,\n  item: $json.item_title,\n  buyer: $json.buyer_name,\n  question: $json.message_text,\n  class: $json.class,\n  reply: $json.reply,\n  reason: $json.reason\n};\n\nstore.journal.push(rec);\nif (store.journal.length > 500) store.journal.shift();\n\nreturn [{ json: rec }];"
