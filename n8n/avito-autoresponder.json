        "jsCode": "// callback_data приходит как \"send:<chat_id>\" или \"skip:<chat_id>\".\nconst cb = $json.body && $json.body.callback_query;\nif (!cb) return [];\n\nconst parts = String(cb.data || '').split(':');\nconst action = parts[0];\n\n// «Отвечу сам» — дальше по цепочке не идём.\nif (action !== 'send') return [];\n\nreturn [{ json: {\n  chat_id: parts[1],\n  reply: parts.slice(2).join(':'),\n  approved: true\n}}];"
      },
