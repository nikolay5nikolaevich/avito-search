    {
      "parameters": {
        "jsCode": "// Отсеиваем чаты, про которые уже отвечали.\n// staticData — память между запусками, живёт у активного воркфлоу.\nconst store = $getWorkflowStaticData('global');\nconst seen = store.seen || {};\n\nconst myId = $('Кто я').first().json.id;\nconst chats = $input.first().json.chats || [];\nconst out = [];\n\nfor (const chat of chats) {\n  const lastId = chat.last_message && chat.last_message.id;\n  if (!chat.id || !lastId) continue;\n  if (seen[chat.id] === lastId) continue;\n\n  // Своё же сообщение обрабатывать не надо.\n  if (chat.last_message.author_id === myId) {\n    seen[chat.id] = lastId;\n    continue;\n  }\n  seen[chat.id] = lastId;\n\n  const ctx = (chat.context && chat.context.value) || {};\n  const buyer = (chat.users || []).find(u => u.id !== myId) || {};\n\n  out.push({ json: {\n    chat_id: chat.id,\n    item_id: ctx.id || '',\n    item_title: ctx.title || 'без названия',\n    item_price: ctx.price_string || 'не указана',\n    item_url: ctx.url || '',\n    buyer_name: buyer.name || 'аноним',\n    message_text: (chat.last_message.content && chat.last_message.content.text) || '(нетекстовое сообщение)'\n  }});\n}\n\nstore.seen = seen;\nreturn out;"
      },
