.cursor/
.cursorrules
.windsurf/
.windsurfrules
.aider*
.continue/
.mcp.json
.claudeignore
.artifact_deps/
skills-lock.json
docs/_internal/

# ─── Секреты окружения — никогда не коммитить ────────────────────────────
.env
.env.*
*.env
secrets.json

# ─── Кэш инструментов разработки ─────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

