# ─── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ─── Артефакты приложения (создаются при запуске) ────────────────────────
cache.db
outreach.db
it_outreach.db
smoke_cache.db
resale_cache.db
agents.db*
logs/
debug/
tmp/
trash/

# Профиль Playwright — личные куки и сессия, не коммитить
.pw-profile/

# ─── Node / фронтенд ─────────────────────────────────────────────────────
node_modules/
*.log
frontend/dist/

# ─── Markdown: в репозитории только README.md и CLAUDE.md из корня ───────
# Отчёты, спеки, брифы и заметки остаются на диске, но в git не попадают.
*.md
*.mdc
!/README.md
!/CLAUDE.md

